# Copy to .env and fill in. Never commit .env.

# --- Reused from Demo 1 (same local n8n, same Slack webhook) ---
OPENAI_API_KEY=
N8N_BASE_URL=
N8N_API_KEY=
SLACK_WEBHOOK_URL=

# --- Demo 2 ---
# Lead webhook (set by n8n/deploy.py) and the shared secret the form/runner send
LEAD_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Base inbox for test leads; the runner turns it into name+<run>+L01@gmail.com
TEST_EMAIL_BASE=
# HubSpot private app token
HUBSPOT_TOKEN=
# Google OAuth client (Gmail send + Sheets) for n8n
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Test runner's read-only token (written by scripts/google_auth.py)
GOOGLE_RUNNER_REFRESH_TOKEN=
# Google Sheet id for the "Lead log"
LEAD_LOG_SHEET_ID=
# Manual review sheet (created by eval/review_sheet.py export-google)
MANUAL_REVIEW_SHEET_ID=
# Cal.com free booking link
BOOKING_LINK=
